#!/usr/bin/env bash
# Refuse a push the release-shaped half of the gate rejects. Enable with:
#
#   git config core.hooksPath .githooks
#
# Bypass with `git push --no-verify`.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! scripts/gate.sh push; then
  printf '\nPush refused. Fix the above, or push with --no-verify.\n' >&2
  exit 1
fi
