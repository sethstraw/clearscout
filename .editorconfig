# Cross-editor baseline, so an editor gets indentation and line endings right
# before ruff or Prettier runs. Those two own the formatting; this file only
# stops an editor fighting them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.css]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown, so they are not stray.
trim_trailing_whitespace = false

[*.{json,yml,yaml,ts,tsx,js,mjs,sh}]
indent_size = 2
