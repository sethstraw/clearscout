{
  "name": "clearscout-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path ../.prettierignore ..",
    "format:check": "prettier --check --ignore-path ../.gitignore --ignore-path ../.prettierignore ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "knip": "knip",
    "api:generate": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@tanstack/react-query": "5.106.1",
    "@uiw/react-md-editor": "4.1.2",
    "driver.js": "1.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "msw": "^3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint",
      "minimatch@^3": "3.1.5"
    }
  },
  "allowScripts": {
    "msw@3.0.4": true
  }
}
